params {
    manifest     = "bams_manifest.csv"
    batch_size   = 100
    fastq_outdir = "fastq_batches"
    samplesheets = "samplesheets"
}

process {
    executor = 'slurm'
    queue = 'normal'

    withName: 'BAM_TO_FASTQ.*' {
        cpus = 8
        memory = '32 GB'
        time = '12h'
    }

    withName: MAKE_SAMPLESHEET {
        cpus = 1
        memory = '2 GB'
        time = '1h'
    }
}

profiles {
    conda {
        process.executor = 'local'
        conda.enabled = true
        singularity.enabled = false
        apptainer.enabled = false
        docker.enabled = false
    }

    docker {
        process.executor = 'local'
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        conda.enabled = false
        singularity.enabled = false
        apptainer.enabled = false
    }

    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        conda.enabled = false
        docker.enabled = false
        apptainer.enabled = false
    }
}
