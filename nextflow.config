params {
    manifest     = "bams_manifest.csv"
    batch_size   = 100
    fastq_outdir = "fastq_batches"
    samplesheets = "samplesheets"
}

process {
    executor = 'slurm'
    queue = 'normal'

    withName: BAM_TO_FASTQ {
        cpus = 8
        memory = '32 GB'
        time = '12h'
    }

    withName: MAKE_SAMPLESHEET {
        cpus = 1
        memory = '2 GB'
        time = '1h'
    }
}

singularity {
    enabled = true
    autoMounts = true
}
