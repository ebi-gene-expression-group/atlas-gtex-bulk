params {
    manifest   = "bams_manifest.csv"
    batch_size = 100
    batchinfo  = "batch_info"
}

process {
    executor = 'slurm'
    queue = 'production'
    time = '12h'
    memory = '8 GB'

    withName: DETECT_READ_TYPE {
        container = { workflow.containerEngine == 'singularity' && !task.ext.singularity_pull_docker_container ? 'https://depot.galaxyproject.org/singularity/samtools:1.22.1--h96c455f_0' : 'quay.io/biocontainers/samtools:1.22.1--h96c455f_0' }
    }

    withName: CREATE_BATCH_INFO {
        cpus = 1
        memory = '2 GB'
        time = '1h'
    }

    maxRetries = 2

    errorStrategy = {
        task.exitStatus in [137, 140, 143, 104, 134] ? 'retry' : 'terminate'
    }

    withName: '.*STAR_ALIGN' {
        cpus = 9
        memory = { task.attempt == 1 ? 48.GB :
                task.attempt == 2 ? 64.GB :
                                    80.GB }
        time   = { task.attempt == 1 ? 1.h :
                task.attempt == 2 ? 2.h :
                                    4.h }
    }

    withName: '.*SORTMERNA' {
        cpus = 8
        memory = { task.attempt == 1 ? 24.GB :
                task.attempt == 2 ? 48.GB :
                                    96.GB }
        time   = { task.attempt == 1 ? 5.h :
                task.attempt == 2 ? 8.h :
                                    12.h }
    }

    withName: '.*SALMON_QUANT' {
        cpus = 5
        memory = { task.attempt == 1 ? 24.GB :
                task.attempt == 2 ? 32.GB :
                                    48.GB }
        time   = { task.attempt == 1 ? 30.m :
                task.attempt == 2 ? 1.h :
                                    2.h }
    }

    withName: '.*TRIMGALORE' {
        cpus = 7
        memory = { task.attempt == 1 ? 24.GB :
                task.attempt == 2 ? 36.GB :
                                    72.GB }
        time   = { task.attempt == 1 ? 60.m :
                task.attempt == 2 ? 2.h :
                                    4.h }
    }

    withName: '.*KRAKEN2' {
        cpus = 2
        memory = { task.attempt == 1 ? 10.GB :
                task.attempt == 2 ? 16.GB :
                                    24.GB }
        time   = { task.attempt == 1 ? 15.m :
                task.attempt == 2 ? 30.m :
                                    1.h }
    }

    withName: '.*SAMTOOLS_SORT' {
        cpus = 4
        memory = { task.attempt == 1 ? 7.GB :
                task.attempt == 2 ? 12.GB :
                                    20.GB }
        time   = { task.attempt == 1 ? 15.m :
                task.attempt == 2 ? 30.m :
                                    1.h }
    }

    withName: '.*BRACKEN' {
        cpus = 1
        memory = { task.attempt == 1 ? 1.GB :
                task.attempt == 2 ? 2.GB :
                                    4.GB }
        time   = { ask.attempt == 1 ? 16.h :
                task.attempt == 2 ? 20.h :
                                    24.h }
    }
}

profiles {
    conda {
        process.executor = 'local'

        conda.enabled = true
        singularity.enabled = false
        apptainer.enabled = false
        docker.enabled = false
    }

    docker {
        process.executor = 'local'

        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'

        conda.enabled = false
        singularity.enabled = false
        apptainer.enabled = false
    }

    singularity {
        process.executor = 'slurm'

        singularity.enabled = true
        singularity.autoMounts = true
        singularity.pullTimeout = '2h'

        conda.enabled = false
        docker.enabled = false
        apptainer.enabled = false
    }
}
